# Vision provider: "openai", "openrouter", "anthropic", or "none" (precomputed observations only)
RM_VISION_PROVIDER=openrouter
OPENAI_API_KEY=
RM_OPENAI_MODEL=gpt-4o
OPENROUTER_API_KEY=
RM_OPENROUTER_MODEL=openai/gpt-4o
ANTHROPIC_API_KEY=
RM_ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# Minimum observation confidence (0-1) required to PASS or FAIL a check; below it the check is UNCERTAIN
RM_CONFIDENCE_THRESHOLD=0.7
# Where evidence records and photos are stored
RM_DATA_DIR=data
# Reasoning-model review (OpenRouter): explains verdicts, drafts claims; can only escalate ACCEPT -> UNCERTAIN
RM_REASONING=on
RM_REASONING_MODEL=openai/gpt-5-mini
RM_REASONING_EFFORT=medium
# Credit guard: refuse model calls that would leave less than this on the key, or exceed this per server session
RM_MIN_CREDIT_USD=0.25
RM_MAX_SPEND_USD=1.00
